# ========= LLM 配置(必填,任选一家 OpenAI 兼容接口)=========
# 通义千问(DashScope):
#   LLM_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
# DeepSeek:
#   LLM_API_URL=https://api.deepseek.com/chat/completions
# 本地 Ollama(无需真实密钥):
#   LLM_API_URL=http://host.docker.internal:11434/v1/chat/completions
LLM_API_URL=
LLM_API_KEY=
LLM_MODEL=qwen-plus

# ========= 账号与鉴权(C/S 商业模式)=========
# required = 登录制(默认,推荐):除 health/auth 外所有接口需 Bearer 令牌
# optional = 迁移期兼容:允许匿名访问(保留旧 X-Access-Code 门禁)
AUTH_MODE=required
# 注册开关:open(开放注册)| invite(邀请码注册)| closed(暂停注册)
REGISTRATION_MODE=open
# REGISTRATION_MODE=invite 时生效
AUTH_INVITE_CODE=
# 运营者账号(首次启动自动创建,不填则跳过;仅运营者可管理知识库)
ADMIN_USERNAME=
ADMIN_PASSWORD=
# [legacy 迁移期] 旧版共享口令;客户端升级完成后请清空并删除
ACCESS_CODE=

# ========= 可选项 =========
# 允许的跨域来源,逗号分隔(经 nginx 同源访问时无需修改)
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
# Chat 温度(0.0-2.0)
CHAT_TEMPERATURE=0.7
